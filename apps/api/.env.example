# ============================================================================
#  Task Board API — Environment Variables (ตัวอย่าง)
#  คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ============================================================================

# ── Database (Postgres / Supabase) ──────────────────────────────────────────
# Runtime ใช้ transaction pooler (Supavisor, port 6543) เพื่อรองรับ connection จำนวนมาก
# DIRECT_URL ใช้ port 5432 สำหรับ Prisma migrate/introspect
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Local fallback (docker compose up -d db):
# DATABASE_URL="postgresql://taskboard:taskboard@localhost:5432/taskboard"
# DIRECT_URL="postgresql://taskboard:taskboard@localhost:5432/taskboard"

# ── JWT ─────────────────────────────────────────────────────────────────────
# JWT_SECRET ใช้เซ็น access token — ต้องยาว >=32 ตัวอักษร และเปลี่ยนเป็นค่าลับจริงใน
# production (แอปจะ fail ตอน boot ถ้าเป็นค่า default/สั้นเกินไป). Refresh token เป็น
# opaque random (ไม่ใช่ JWT) เก็บแบบ hash จึงไม่มี JWT_REFRESH_SECRET — แอปไม่เคยอ่านค่านี้
JWT_SECRET="change-me-access-secret-at-least-32-chars-long"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3001
WEB_URL="http://localhost:5173"
NODE_ENV="development"

# ── Email — PRODUCTION: Gmail API over HTTPS (recommended, ADR 0009) ─────────
# ⚠ ทำไมต้องใช้ Gmail API แทน SMTP บน production:
#   Railway (trial tier) BLACKHOLE ทุก outbound SMTP (drop packet เงียบ ๆ) → ส่งเมลผ่าน
#   SMTP ไม่มีทางถึงเลย. HTTPS egress ไม่เคยถูกบล็อก เราจึงส่ง RFC822 message เดียวกัน
#   ผ่าน Gmail REST API แทน. โค้ดจะใช้เส้นทางนี้ "อัตโนมัติ" เมื่อครบทั้ง 3 ค่าด้านล่าง;
#   ถ้าไม่ครบ จะ fallback ไปใช้ SMTP block ด้านล่าง (เหมาะกับ local dev + Mailpit).
#
# วิธีตั้งค่า (ทำครั้งเดียว):
#   1) ใช้ OAuth 2.0 Client (Web application) ตัวเดิมที่ใช้ทำ Google login ก็ได้
#      (GOOGLE_CLIENT_ID/SECRET) หรือจะสร้างใหม่แยกก็ได้.
#   2) Google Cloud Console → APIs & Services:
#        • เปิดใช้งาน "Gmail API" ให้ project
#        • Credentials → OAuth client → Authorized redirect URIs → เพิ่ม:
#            http://localhost:8765/oauth2callback
#        • OAuth consent screen → เพิ่ม scope: https://www.googleapis.com/auth/gmail.send
#          (โหมด Testing + ใส่อีเมลเจ้าของเป็น test user ก็พอ)
#   3) รันสคริปต์ (อ่าน GOOGLE_CLIENT_ID/SECRET จาก .env นี้ให้เอง):
#            node ops/scripts/gmail-oauth-setup.mjs
#      เปิด URL ที่มันพิมพ์ → กด allow → สคริปต์จะพิมพ์ refresh token + 3 บรรทัด env ให้
#   4) วาง 3 ค่าด้านล่างลง Railway Variables (หรือไฟล์ .env นี้สำหรับ local)
#   5) EMAIL_FROM ต้องเป็นอีเมล Gmail บัญชีเดียวกับที่กด authorise (DMARC alignment)
#
# ถ้า GMAIL_OAUTH_CLIENT_ID/SECRET ว่าง โค้ดจะ fallback ไปอ่าน GOOGLE_CLIENT_ID/SECRET
# ให้เอง — ปกติจึงตั้งแค่ GMAIL_REFRESH_TOKEN ก็พอถ้าใช้ OAuth client ตัวเดียวกัน.
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# ── Email (SMTP — provider-agnostic; local dev / fallback) ───────────────────
# ใช้เมื่อ "ไม่ได้" ตั้งค่า Gmail API ด้านบน. แอปส่งอีเมลผ่าน SMTP ล้วน ๆ จึงย้ายผู้ให้บริการ
# ได้โดยแก้แค่ค่าในนี้ ไม่ต้องแก้โค้ด
#
# DEV: ค่าเริ่มต้นด้านล่างชี้ไป Mailpit (localhost:1025, ไม่ต้อง auth — ดักอีเมลในเครื่อง).
#   ถ้าไม่มี SMTP เลย ก็ยังพัฒนาได้: ใน NODE_ENV≠production แอปจะ log ลิงก์ยืนยัน/รีเซ็ต
#   ออกมาที่ console เป็น fallback  →  บรรทัดขึ้นต้นด้วย `[MAIL-FALLBACK]`
#
# PRODUCTION (ค่าเริ่มต้น = Gmail SMTP + App Password ของ mailbox เจ้าของแอป):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=<your@gmail.com>        # อีเมล Gmail เต็ม ๆ
#   SMTP_PASS=<App Password 16 ตัว>   # ไม่ใช่รหัสผ่าน Google ปกติ (ดูวิธีสร้างด้านล่าง)
#   EMAIL_FROM=<your@gmail.com>       # ⚠ ต้องเป็น mailbox เดียวกับ SMTP_USER
#
# วิธีสร้าง Gmail App Password:
#   Google Account → Security → เปิด 2-Step Verification ก่อน → App passwords
#   → ตั้งชื่อ (เช่น "Task Board") → Google ให้รหัส 16 ตัว → วางที่ SMTP_PASS
#   (จะมี/ไม่มีช่องว่างก็ได้ แอป strip ช่องว่างให้เอง)
#
# ⚠ DKIM/DMARC alignment: EMAIL_FROM ต้องอยู่บน mailbox/โดเมนที่ SMTP server เซ็นได้จริง
#   ส่งผ่าน Gmail แต่ตั้ง EMAIL_FROM เป็นโดเมนอื่น → DMARC ไม่ align → ปลายทางตีกลับ/เข้า spam
#   ดังนั้นเมื่อใช้ Gmail ให้ EMAIL_FROM == SMTP_USER (อีเมล @gmail.com เดียวกัน).
#   จะย้ายไปโดเมนตัวเองในอนาคต: ตั้ง SMTP_* ของผู้ให้บริการที่ verify โดเมนนั้น
#   แล้ว EMAIL_FROM เป็น addr บนโดเมนนั้น — แก้แค่ env ไม่ต้องแตะโค้ด
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@taskboard.local"

# ── Google OAuth ────────────────────────────────────────────────────────────
# สร้าง OAuth 2.0 Client ID ที่ Google Cloud Console → APIs & Services → Credentials
#   Application type: Web application
#   Authorized redirect URIs: http://localhost:3001/auth/google/callback
# แล้วนำ Client ID / Client Secret มาวางที่นี่
# หมายเหตุ: ถ้า GOOGLE_CLIENT_SECRET ว่าง route /auth/google จะตอบ 503 (ปิดใช้งาน OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Phase 4 — Hocuspocus realtime collaboration shares this API's own HTTP
# server/port (see CollabService#attachToHttpServer) — no separate port/var.

# ── Sprint 4 — Editor image uploads (Supabase Storage, ADR 0004) ─────────────
# รูปภาพในเอกสารถูกอัปโหลดขึ้น Supabase Storage (private bucket) แล้วเก็บเป็น URL สั้น ๆ
# ในเอกสาร แทน base64 ที่ทำให้ ydoc/CRDT บวม. ถ้าไม่ตั้ง 2 ค่าล่าง route อัปโหลดจะตอบ 503.
# SERVICE_ROLE_KEY เป็นความลับฝั่ง server เท่านั้น — ห้าม leak ไป frontend และห้าม commit ค่าจริง
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# ชื่อ bucket (สร้างเป็น private ใน Supabase Storage). ค่าเริ่มต้น: file-assets
SUPABASE_STORAGE_BUCKET="file-assets"
# อายุของ signed URL (วินาที). ค่าเริ่มต้น ~10 ปี เพราะ URL ถูกฝังใน <img src> ของเอกสาร
SUPABASE_SIGNED_URL_TTL="315360000"
