# ============================================================================
#  Task Board API — Environment Variables (ตัวอย่าง)
#  คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ============================================================================

# ── Database (Postgres / Supabase) ──────────────────────────────────────────
# Runtime ใช้ transaction pooler (Supavisor, port 6543) เพื่อรองรับ connection จำนวนมาก
# DIRECT_URL ใช้ port 5432 สำหรับ Prisma migrate/introspect
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Local fallback (docker compose up -d db):
# DATABASE_URL="postgresql://taskboard:taskboard@localhost:5432/taskboard"
# DIRECT_URL="postgresql://taskboard:taskboard@localhost:5432/taskboard"

# ── JWT ─────────────────────────────────────────────────────────────────────
# ต้องยาวอย่างน้อย 32 ตัวอักษร และเปลี่ยนเป็นค่าลับจริงใน production
JWT_SECRET="change-me-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars-long"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3001
WEB_URL="http://localhost:5173"
NODE_ENV="development"

# ── Email ───────────────────────────────────────────────────────────────────
# dev เริ่มต้น = Mailpit SMTP บน port 1025 (ไม่ต้อง auth, ดักอีเมลในเครื่อง)
# production เลือกได้: (A) Resend + verified domain  หรือ  (B) Gmail SMTP + App Password
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#           SMTP_USER=<your@gmail.com>  SMTP_PASS=<16-char App Password>
#   Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
#           SMTP_USER=resend  SMTP_PASS=<re_... API key>  EMAIL_FROM=<addr บนโดเมนที่ verify>
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@taskboard.local"

# ── Google OAuth ────────────────────────────────────────────────────────────
# สร้าง OAuth 2.0 Client ID ที่ Google Cloud Console → APIs & Services → Credentials
#   Application type: Web application
#   Authorized redirect URIs: http://localhost:3001/auth/google/callback
# แล้วนำ Client ID / Client Secret มาวางที่นี่
# หมายเหตุ: ถ้า GOOGLE_CLIENT_SECRET ว่าง route /auth/google จะตอบ 503 (ปิดใช้งาน OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ── Phase 4 — Hocuspocus realtime collaboration WebSocket server ─────────────
COLLAB_PORT=3002
