// Task Board — Prisma schema (Phase 1: Auth Core)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase Supavisor / PgBouncer) for the app at runtime —
  // handles many concurrent connections under heavy load.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  setting            UserSetting?
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  // Phase 2 — Projects & Membership
  ownedProjects   Project[]    @relation("OwnedProjects")
  memberships     Membership[]
  projectPins     ProjectPin[]
  sentInvitations Invitation[] @relation("InvitedBy")

  // Phase 4 — Collaboration / Version history
  revisions Revision[]

  // Phase 5 — Notifications
  notifications Notification[]

  // Sprint 4 — Comments
  comments         Comment[] @relation("CommentAuthor")
  resolvedComments Comment[] @relation("CommentResolver")
}

model UserSetting {
  id         String @id @default(cuid())
  userId     String @unique
  themeColor String @default("violet")
  themeMode  String @default("light")
  language   String @default("th")
  fontSize   Int    @default(14)

  // Phase 5 — per-type notification opt-in (in-app delivery)
  notifyInvite   Boolean @default(true)
  notifyMention  Boolean @default(true)
  notifyRevision Boolean @default(true)
  // Sprint 4 — gates both Comment and CommentReply notifications (single toggle in v1).
  notifyComment  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Pending credential overrides from a reclaim attempt — applied atomically on verify.
  pendingPasswordHash String?
  pendingUsername     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Phase 2: Projects ───────────────────────────────

enum Role {
  Owner
  Editor
  Viewer
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  ownerId     String
  deletedAt   DateTime? // soft-delete (trash, 30-day retention enforced in app)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       User         @relation("OwnedProjects", fields: [ownerId], references: [id])
  memberships Membership[]
  invitations Invitation[]
  pins        ProjectPin[]
  files       File[]

  @@index([ownerId])
  @@index([deletedAt])
}

model Membership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role     @default(Viewer)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // one membership per user per project
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  projectId   String
  email       String // invitee email (may not have an account yet)
  role        Role      @default(Viewer)
  token       String    @unique // SHA-256 hash of the opaque invite token
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([projectId])
  @@index([email])
}

model ProjectPin {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// ─────────────────────────── Phase 3: Files / Work Page ──────────────────────

enum FileKind {
  Folder
  Document
}

model File {
  id          String    @id @default(cuid())
  projectId   String
  parentId    String? // null = root of the project's file tree
  name        String
  kind        FileKind  @default(Document)
  orientation String? // 'portrait' | 'landscape' (documents only)
  content     String? // document body (autosaved); JSON/HTML string
  ydoc        Bytes? // Phase 4 — Yjs CRDT binary state (source of truth while collaborating)
  order       Int       @default(0)
  deletedAt   DateTime? // soft-delete
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    File?      @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  File[]     @relation("FileTree")
  revisions Revision[]
  comments  Comment[]

  @@index([projectId])
  @@index([parentId])
}

// ─────────────────────────── Phase 4: Collaboration / Revisions ──────────────

model Revision {
  id        String   @id @default(cuid())
  fileId    String
  authorId  String
  content   String // HTML snapshot at the time the revision was taken
  label     String? // optional user-set label ("v1.0", "before review", …)
  createdAt DateTime @default(now())

  file     File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]

  @@index([fileId])
}

// ─────────────────────────── Phase 5: Notifications ──────────────────────────

enum NotificationType {
  ProjectInvite // added to / invited to a project
  Mention // @mentioned inside a document
  Revision // a new version was saved in a project you belong to
  Comment // a new comment was posted on a file in a project you belong to
  CommentReply // someone replied to a comment thread you started
}

model Notification {
  id        String           @id @default(cuid())
  userId    String // recipient
  type      NotificationType
  // Denormalised payload rendered by the client (actor name, project/file names,
  // deep-link target, …). JSON keeps the schema stable as notification kinds grow.
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─────────────────────────── Sprint 4: Comments ─────────────────────────────

model Comment {
  id       String  @id @default(cuid())
  fileId   String
  authorId String
  // null = root of a thread. Non-null = a reply. Reply depth is capped at 1 level
  // at the application layer (a reply's parent must itself be a root).
  parentId String?
  body     String  @db.Text // plain-text comment, max 5000 chars (validated at the DTO)

  // Anchor to the highlighted range in the live Yjs document. Stored as serialized
  // Yjs RelativePosition (survives concurrent edits). Null on replies (they inherit
  // the root's anchor) and tolerated when a client posts an unanchored comment.
  anchorFrom Json?
  anchorTo   Json?
  // Plain-text snapshot of the highlighted range at creation — fallback label shown
  // in the panel when the anchor can no longer be resolved (orphaned comment).
  anchorText String?
  // Revision the document was on when this comment was made. Used to detect orphaning
  // after a restore (Open Decision #1, option (a)). SetNull so pruning old revisions
  // never deletes the comment.
  sourceRevisionId String?

  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  file       File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author     User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  revision   Revision? @relation(fields: [sourceRevisionId], references: [id], onDelete: SetNull)

  @@index([fileId]) // list all comments for a file
  @@index([fileId, resolvedAt]) // filter all / unresolved / resolved fast
  @@index([parentId]) // load a thread's replies
}
