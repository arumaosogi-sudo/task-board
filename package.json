{
  "name": "task-board",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:int": "npm run test:int --workspace @task-board/api",
    "test:int:local": "node ops/scripts/test-int-local.mjs",
    "test:e2e:local": "node ops/scripts/test-e2e-local.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "multer": "2.2.0",
    "lodash": "4.18.1",
    "file-type": "21.3.2"
  }
}
