{
  "name": "task-board",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:int": "npm run test:int --workspace @task-board/api",
    "test:int:local": "node ops/scripts/test-int-local.mjs",
    "test:e2e:local": "node ops/scripts/test-e2e-local.mjs"
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.5",
    "turbo": "^2.3.0",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "multer": "2.2.0",
    "lodash": "4.18.1",
    "file-type": "21.3.2"
  }
}
