# ── Database ──────────────────────────────────────────────────────────────────
# Managed Postgres (Supabase). DATABASE_URL = pooled (runtime), DIRECT_URL = session (migrations).
# Get both from Supabase → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Local fallback (docker compose up -d db):
# DATABASE_URL="postgresql://taskboard:taskboard@localhost:5432/taskboard"
# DIRECT_URL="postgresql://taskboard:taskboard@localhost:5432/taskboard"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Access tokens are signed with JWT_SECRET (>=32 chars; boot fails on a weak/default
# value). Refresh tokens are opaque random strings (not JWTs) stored hashed, so there
# is deliberately no JWT_REFRESH_SECRET here — it was never read by the app.
JWT_SECRET="change-me-in-production-at-least-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
WEB_URL="http://localhost:5173"
# CORS allowlist (comma-separated). Falls back to WEB_URL when unset.
# e.g. CORS_ORIGINS="http://localhost:5173,https://taskboard.example.com"
CORS_ORIGINS="http://localhost:5173"
NODE_ENV="development"

# ── Web SPA (Vite — baked in at build time) ───────────────────────────────────
# Collab (Hocuspocus) shares the API's own port/server — same host as VITE_API_URL.
VITE_API_URL="http://localhost:3001"
VITE_COLLAB_URL="ws://localhost:3001"

# ── Email (dev = Mailpit SMTP on port 1025) ───────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@taskboard.local"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""  # from Google Cloud Console → Credentials (OAuth 2.0 Client ID)
GOOGLE_CLIENT_SECRET=""  # leave empty until provided — Google routes return 503 while unset
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
