# Production environment variables — TEMPLATE ONLY, no real values.
#
# This file documents what must be set on the deploy platform (Railway/Fly.io
# dashboard → service → Variables, or your secret manager) for a production
# release. It is NOT consumed directly by docker-compose or the app — copy
# each var into the platform's env/secret store yourself.
#
# See docs/prod-readiness-plan.md §8 for who must supply each value and why.
# NEVER commit a real `.env`, `.env.production`, or any file with actual
# secret values — `.gitignore` already blocks `.env*`.

# ── Database (Supabase or other managed Postgres) ─────────────────────────────
# DATABASE_URL = pooled connection (runtime, pgbouncer transaction mode, :6543)
# DIRECT_URL   = session connection (migrations only, no pooler, :5432)
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>:6543/<db>?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>:5432/<db>"

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate fresh values — do NOT reuse the docker-compose.yml dev defaults.
#   openssl rand -base64 48
JWT_SECRET="<generate-a-new-random-secret-at-least-32-chars>"
# NOTE (security review finding #8): JWT_REFRESH_SECRET is currently unused —
# refresh tokens are opaque (hashed at rest), not JWTs. Kept here for forward
# compatibility; confirm with dev whether it's still needed before relying on it.
JWT_REFRESH_SECRET="<generate-a-different-random-secret-at-least-32-chars>"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# ── Sign-up ────────────────────────────────────────────────────────────────
# Set to "true" to refuse POST /auth/register. Required on any deployment with
# no mail provider: without one the verification email cannot be sent, so a new
# account can never pass the emailVerified check in login. Leave unset to keep
# public sign-up open. The web build has a matching VITE_SIGNUP_DISABLED that
# hides the UI routes; the API is the gate that actually refuses.
SIGNUP_DISABLED="false"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3001
WEB_URL="https://<your-web-domain>"
CORS_ORIGINS="https://<your-web-domain>"

# ── Web SPA (Vite — baked into the bundle at BUILD time, not runtime) ────────
# Changing these requires rebuilding the web image, not just restarting it.
VITE_API_URL="https://<your-api-domain>"
VITE_COLLAB_URL="wss://<your-api-domain>"

# ── Email — PRIMARY: Gmail API over HTTPS (ADR 0009) ─────────────────────────
# The app sends mail via the Gmail REST API when all three GMAIL_* vars are set.
# This is the primary path in production: PaaS trial tiers (e.g. Railway) silently
# blackhole outbound SMTP, but HTTPS egress is never blocked. Client id/secret fall
# back to the GOOGLE_* OAuth vars below if the GMAIL_OAUTH_* pair is omitted.
# Generate the refresh token once with: node ops/scripts/gmail-oauth-setup.mjs
GMAIL_OAUTH_CLIENT_ID="<Gmail OAuth client id — or reuse GOOGLE_CLIENT_ID>"
GMAIL_OAUTH_CLIENT_SECRET="<Gmail OAuth client secret — or reuse GOOGLE_CLIENT_SECRET>"
GMAIL_REFRESH_TOKEN="<long-lived refresh token from gmail-oauth-setup.mjs>"

# ── Email — FALLBACK: SMTP provider (used only when Gmail API vars are unset) ──
# See docs/prod-readiness-plan.md §5. Only reachable if the platform permits SMTP.
SMTP_HOST="<smtp.sendgrid.net | email-smtp.<region>.amazonaws.com | ...>"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="<provider-smtp-username>"
SMTP_PASS="<provider-smtp-password-or-api-key>"
EMAIL_FROM="noreply@<your-verified-sending-domain>"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Leave GOOGLE_CLIENT_SECRET unset to keep Google login disabled (routes
# return 503 by design) instead of committing a placeholder.
GOOGLE_CLIENT_ID="<confirm-or-create-in-Google-Cloud-Console>"
GOOGLE_CLIENT_SECRET="<from-Google-Cloud-Console-Credentials>"
GOOGLE_CALLBACK_URL="https://<your-api-domain>/auth/google/callback"
